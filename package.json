{
  "name": "agent-helenite",
  "version": "0.1.0",
  "description": "Drive Claude Code and Codex agent sessions from a TypeScript app.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "chat": "tsx src/cli/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "bundle": "node scripts/bundle.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "plugin:build": "node scripts/plugin.mjs",
    "plugin:dev": "node scripts/dev-vault.mjs && node scripts/plugin.mjs --vault dev-vault --watch",
    "test:obsidian": "vitest run test/obsidian"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "obsidian": "^1.8.7",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
